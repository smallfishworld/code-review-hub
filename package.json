{
  "name": "code-review-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Automated AI code review platform for SVN/Git repositories, built on the ocr CLI",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:web",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "npm --prefix web run dev",
    "build": "npm-run-all --parallel build:server build:web",
    "build:server": "tsc -p server/tsconfig.json",
    "build:web": "npm --prefix web run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node server/dist/index.js",
    "package:win": "node scripts/package-win.mjs",
    "package:mac": "node scripts/package-mac.mjs",
    "package:linux": "node scripts/package-linux.mjs",
    "release:notes": "node scripts/generate-release-notes.mjs",
    "lint": "eslint server/src && npm --prefix web run lint"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@vitest/runner": "^4.1.11",
    "eslint": "^10.15.0",
    "npm-run-all": "^4.1.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@colbymchenry/codegraph": "1.6.3",
    "@fastify/static": "^10.1.11",
    "better-sqlite3": "^13.2.0",
    "fastify": "^5.12.8",
    "nodemailer": "^10.6.0"
  }
}
